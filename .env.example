# Resend (recommended for form emails)
# 1) Create account at https://resend.com
# 2) Create API key → paste below
# 3) For production, verify raichevelectric.com in Resend → Domains
RESEND_API_KEY=
CONTACT_TO_EMAIL=steven@raichevelectric.com
# Until domain is verified, use: Raichev Electric <onboarding@resend.dev>
# After DNS verify, use: Raichev Electric <steven@raichevelectric.com> or noreply@...
CONTACT_FROM_EMAIL=Raichev Electric <onboarding@resend.dev>

# Optional fallback webhook (Zapier/Make/etc.)
# CONTACT_FORM_WEBHOOK_URL=
